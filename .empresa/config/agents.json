{
  "version": "6.3",
  "nombre": "AI-SQUAD Framework",

  "model_discipline": {
    "note": "OpenCode uses ONE model per session. The CEO MUST switch models between phases using the /model command. Each agent prompt declares its required model. Agents running on wrong model = invalid output.",
    "ceo_default": "MiniMax M2.7",
    "switch_command": "In OpenCode: press Ctrl+Shift+M or use command palette to change model"
  },

  "agentes": {
    "researcher": {
      "modelo": "Qwen3.5 Plus",
      "backup": "DeepSeek V4 Flash",
      "coste": "bajo",
      "escribe_codigo": false,
      "skills": [
        "tech-research",
        "competitive-analysis",
        "domain-knowledge"
      ],
      "archivos": [
        "docs/research/*.md"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "Investigación y análisis. NO escribe código. Backup DeepSeek V4 Flash si Qwen está lento."
    },

    "specifier": {
      "modelo": "Kimi K2.6",
      "backup": "MiniMax M2.7",
      "coste": "alto",
      "escribe_codigo": false,
      "skills": [
        "contract-writing",
        "api-design",
        "data-modeling"
      ],
      "archivos": [
        "docs/specs/*.md"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "ÚNICO agente que usa Kimi K2.6. Precisión quirúrgica para contratos. NO escribe código. Es el más caro, solo se usa en Fase 1."
    },

    "designer": {
      "modelo": "GLM-5.1",
      "backup": "Qwen3.5 Plus",
      "coste": "medio",
      "escribe_codigo": false,
      "skills": [
        "direction-picker",
        "design-systems",
        "whimsy-injector",
        "accessibility-design"
      ],
      "archivos": [
        "DESIGN.md",
        "docs/UX_FLOW.md"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "Tokens visuales con Direction Picker + Design Systems. NO toca src/. GLM-5.1 es bueno para diseño."
    },

    "accessibility-auditor": {
      "modelo": "Qwen3.5 Plus",
      "backup": "DeepSeek V4 Flash",
      "coste": "bajo",
      "escribe_codigo": false,
      "skills": [
        "wcag-audit",
        "screen-reader-testing",
        "color-contrast",
        "keyboard-navigation"
      ],
      "archivos": [
        "docs/a11y-audits/*.md"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "WCAG 2.2 AA. Solo audita DESIGN.md, no toca código. Va SEGUNDO tras Designer."
    },

    "frontend": {
      "modelo": "MiniMax M2.7",
      "backup": "MiniMax M2.5",
      "coste": "medio-bajo",
      "escribe_codigo": true,
      "skills": [
        "react-development",
        "css-modules",
        "vanilla-js",
        "html5-semantic",
        "responsive-design",
        "vitest-testing"
      ],
      "archivos": [
        "src/components/**/*",
        "src/hooks/**/*",
        "src/*.css",
        "src/App.tsx",
        "public/**/*"
      ],
      "excluye": [
        "src/routes/**/*",
        "src/services/**/*",
        "src/**/*.test.*"
      ],
      "nota": "MiniMax M2.7: calidad de código a coste óptimo. Backup MiniMax M2.5 si hay rate limits."
    },

    "backend": {
      "modelo": "MiniMax M2.7",
      "backup": "MiniMax M2.5",
      "coste": "medio-bajo",
      "escribe_codigo": true,
      "skills": [
        "express-framework",
        "fastapi-framework",
        "api-design",
        "auth-jwt",
        "database-design"
      ],
      "archivos": [
        "src/routes/**/*",
        "src/services/**/*",
        "src/api/**/*",
        "src/logic/**/*",
        "src/types/**/*",
        "src/middleware/**/*",
        "server.*"
      ],
      "excluye": [
        "src/components/**/*",
        "src/**/*.test.*"
      ],
      "nota": "MiniMax M2.7: APIs robustas a coste óptimo. Backup MiniMax M2.5 si hay rate limits."
    },

    "qa": {
      "modelo": "DeepSeek V4 Flash",
      "backup": "GLM-5",
      "coste": "muy-bajo",
      "escribe_codigo": true,
      "skills": [
        "vitest-testing",
        "jest-testing",
        "supertest-api",
        "anti-slop-checklist",
        "loop-closer"
      ],
      "archivos": [
        "src/**/*.test.*",
        "tests/**/*",
        "coverage/**/*"
      ],
      "excluye": [],
      "nota": "DeepSeek V4 Flash: el más rápido y barato, ideal para generar cientos de tests. Backup GLM-5."
    },

    "integrator": {
      "modelo": "Qwen3.5 Plus",
      "backup": "DeepSeek V4 Flash",
      "coste": "bajo",
      "escribe_codigo": true,
      "skills": [
        "integration-contracts",
        "cross-agent-audit",
        "api-verification",
        "loop-closer"
      ],
      "archivos": [
        "docs/integration/*.md",
        "tests/integration/**/*"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "Verifica contratos cruzados, NO escribe código productivo. Solo tests de integración y reportes. Va DESPUÉS del Build."
    },

    "reality-checker": {
      "modelo": "Qwen3.5 Plus",
      "backup": "DeepSeek V4 Flash",
      "coste": "bajo",
      "escribe_codigo": false,
      "skills": [
        "visual-evidence",
        "user-journey-testing",
        "production-readiness",
        "spec-vs-reality"
      ],
      "archivos": [
        "docs/reality-checks/*.md"
      ],
      "excluye": [
        "src/**/*"
      ],
      "nota": "Gatekeeper visual. Default: NEEDS WORK. Solo inspecciona, no escribe código. Va ÚLTIMO antes del CEO."
    }
  },

  "model_usage_summary": {
    "Kimi K2.6": {
      "agentes": ["specifier"],
      "fase": "1 (Spec)",
      "coste_estimado": "Alto — solo 1 agente, ~5 min"
    },
    "MiniMax M2.7": {
      "agentes": ["frontend", "backend"],
      "fase": "4 (Build)",
      "coste_estimado": "Medio — 2 agentes en paralelo, ~20-30 min"
    },
    "GLM-5.1": {
      "agentes": ["designer"],
      "fase": "3 (Design)",
      "coste_estimado": "Medio — 1 agente, ~10 min"
    },
    "Qwen3.5 Plus": {
      "agentes": ["researcher", "accessibility-auditor", "integrator", "reality-checker"],
      "fase": "0.5, 3.5, 5, 6",
      "coste_estimado": "Bajo — 4 agentes secuenciales, ~5 min cada uno"
    },
    "DeepSeek V4 Flash": {
      "agentes": ["qa"],
      "fase": "4 (Build)",
      "coste_estimado": "Muy bajo — genera tests masivos, ~10-15 min"
    }
  },

  "idle_behavior": {
    "researcher": ["trend-watch", "competitor-monitor"],
    "specifier": ["contract-review", "spec-refinement"],
    "designer": ["design-system-audit", "token-optimization"],
    "accessibility-auditor": ["a11y-best-practices", "wcag-standards-review"],
    "frontend": ["ui-review", "css-optimization", "bundle-size-audit"],
    "backend": ["refactor-proposals", "performance-review", "query-optimization"],
    "qa": ["code-review", "coverage-improvement", "gap-tracking"],
    "integrator": ["contract-audit", "integration-health-check"],
    "reality-checker": ["visual-regression-review", "ux-audit"]
  }
}
